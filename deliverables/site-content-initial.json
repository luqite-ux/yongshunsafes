        "company": {
          "hidden": false,
          "values": {
            "eyebrow": {
              "en": "Company"
            },
            "title": {
              "en": "Who is the manufacturer?"
            },
            "body": {
              "en": "Zhejiang Wuyi Yongshun Safe Cabinet Co., Ltd. integrates design, R&D, production and sales of mechanical, electronic and fingerprint safes and storage boxes under the Yongshun and Manadun brands."
            },
            "registration": {
              "en": "Business registration dates from 23 August 2012. The company works from the Jinyanshan Industrial Area in Quanxi Town, Wuyi County, Zhejiang."
            },
            "factory_image": {
              "assetId": "86e13570-91ad-4a1a-bfb0-309fc06925a7",
              "alt": {
                "en": "Company entrance in Wuyi"
              }
            },
            "exhibition_image": {
              "assetId": "2ffeeca6-6f02-4418-9397-d0ceb300a375",
              "alt": {
                "en": "Company exhibition booth"
              }
            }
          }
        },
        "faq": {
          "hidden": false,
          "values": {
            "eyebrow": {
              "en": "Before you order"
            },
            "title": {
              "en": "What should I confirm before ordering?"
            },
            "body": {
              "en": "Quantity, samples, lead time, inspection and packaging, answered in one place."
            },
            "groups": [
              {
                "id": "product",
                "title": {
                  "en": "Models and customization"
                },
                "items": [
                  {
                    "id": "product-0",
                    "question": {
                      "en": "What sizes and models are available?"
                    },
                    "answer": {
                      "en": "The range includes compact, mid-size and tall cabinets. Compare each series and its model dimensions in the product catalogue."
                    }
                  },
                  {
                    "id": "product-1",
                    "question": {
                      "en": "Can size, material, colour or process be customized?"
                    },
                    "answer": {
                      "en": "Yes. Send your required dimensions, material, colour and process so the factory can confirm the order specification."
                    }
                  },
                  {
                    "id": "product-2",
                    "question": {
                      "en": "Can you provide samples?"
                    },
                    "answer": {
                      "en": "Yes. Samples can be arranged before a production order."
                    }
                  },
                  {
                    "id": "product-3",
                    "question": {
                      "en": "Are technical data sheets and test reports available?"
                    },
                    "answer": {
                      "en": "Yes. Request the technical data sheet or available test report for the exact model you are considering."
                    }
                  },
                  {
                    "id": "product-4",
                    "question": {
                      "en": "Which applications does the range serve?"
                    },
                    "answer": {
                      "en": "Applications include offices, homes, security storage and banks. Select the cabinet construction and access option for the intended use."
                    }
                  },
                  {
                    "id": "product-5",
                    "question": {
                      "en": "Can additional protective features be discussed?"
                    },
                    "answer": {
                      "en": "Fire-resistance and anti-theft requirements can be discussed for custom orders. Confirm the required construction and documentation for the specific model."
                    }
                  }
                ]
              },
              {
                "id": "pricing",
                "title": {
                  "en": "Quantity and quotation"
                },
                "items": [
                  {
                    "id": "pricing-0",
                    "question": {
                      "en": "What is the minimum order quantity?"
                    },
                    "answer": {
                      "en": "The minimum order quantity is 20 units."
                    }
                  },
                  {
                    "id": "pricing-1",
                    "question": {
                      "en": "Is pricing tiered by quantity?"
                    },
                    "answer": {
                      "en": "Yes. Send your chosen models and quantity for a tiered quotation."
                    }
                  },
                  {
                    "id": "pricing-2",
                    "question": {
                      "en": "Does the quotation include packaging, shipping and tax?"
                    },
                    "answer": {
                      "en": "Packaging is included. Shipping and tax are excluded and should be confirmed separately."
                    }
                  },
                  {
                    "id": "pricing-3",
                    "question": {
                      "en": "Can long-term cooperation and bulk pricing be discussed?"
                    },
                    "answer": {
                      "en": "Yes. Long-term cooperation pricing and bulk discounts can be discussed for your order."
                    }
                  },
                  {
                    "id": "pricing-4",
                    "question": {
                      "en": "Do raw-material or exchange-rate movements affect the quoted price?"
                    },
                    "answer": {
                      "en": "The company states that its quoted price is not adjusted for those movements. Confirm the quotation terms with the sales team before ordering."
                    }
                  }
                ]
              },
              {
                "id": "samples",
                "title": {
                  "en": "Samples and approval"
                },
                "items": [
                  {
                    "id": "samples-0",
                    "question": {
                      "en": "Can samples be shipped?"
                    },
                    "answer": {
                      "en": "Yes. Sample shipment can be arranged with the sales team."
                    }
                  },
                  {
                    "id": "samples-1",
                    "question": {
                      "en": "Are samples charged and refundable?"
                    },
                    "answer": {
                      "en": "Samples are charged and non-refundable."
                    }
                  },
                  {
                    "id": "samples-2",
                    "question": {
                      "en": "What is the normal sample lead time?"
                    },
                    "answer": {
                      "en": "Normal sample lead time is about 30 days."
                    }
                  },
                  {
                    "id": "samples-3",
                    "question": {
                      "en": "Can a custom sample be approved before production?"
                    },
                    "answer": {
                      "en": "Yes. A custom sample can be prepared for your confirmation before mass production."
                    }
                  },
                  {
                    "id": "samples-4",
                    "question": {
                      "en": "Is the approved sample used for the production order?"
                    },
                    "answer": {
                      "en": "Yes. The approved sample is the reference for the agreed production specification."
                    }
                  }
                ]
              },
              {
                "id": "production",
                "title": {
                  "en": "Production and scheduling"
                },
                "items": [
                  {
                    "id": "production-0",
                    "question": {
                      "en": "What is the normal production lead time?"
                    },
                    "answer": {
                      "en": "Normal production lead time is about 30 days after order confirmation."
                    }
                  },
                  {
                    "id": "production-1",
                    "question": {
                      "en": "How is bulk-order delivery scheduled?"
                    },
                    "answer": {
                      "en": "The factory plans bulk orders to maintain a stable delivery schedule. Confirm the dispatch date for your order."
                    }
                  },
                  {
                    "id": "production-2",
                    "question": {
                      "en": "Does peak season change the planned lead time?"
                    },
                    "answer": {
                      "en": "The company plans peak-season production around the normal lead time. Confirm your required delivery date when ordering."
                    }
                  },
                  {
                    "id": "production-3",
                    "question": {
                      "en": "Is expedited production available?"
                    },
                    "answer": {
                      "en": "Urgent production requests are supported. Contact the team to confirm availability for your model and quantity."
                    }
                  },
                  {
                    "id": "production-4",
                    "question": {
                      "en": "Can production progress updates be provided?"
                    },
                    "answer": {
                      "en": "Yes. Progress updates can be provided while your order is in production."
                    }
                  }
                ]
              },
              {
                "id": "inspection",
                "title": {
                  "en": "Inspection and communication"
                },
                "items": [
                  {
                    "id": "inspection-0",
                    "question": {
                      "en": "Is there a quality-control process?"
                    },
                    "answer": {
                      "en": "Yes. The company has a quality-control process for production and outgoing inspection."
                    }
                  },
                  {
                    "id": "inspection-1",
                    "question": {
                      "en": "Is third-party inspection supported?"
                    },
                    "answer": {
                      "en": "Yes. Third-party inspection can be arranged for your order."
                    }
                  },
                  {
                    "id": "inspection-2",
                    "question": {
                      "en": "Are inspection reports available?"
                    },
                    "answer": {
                      "en": "Yes. Outgoing inspection and inspection reports are available."
                    }
                  },
                  {
                    "id": "inspection-3",
                    "question": {
                      "en": "How should a product quality issue be raised?"
                    },
                    "answer": {
                      "en": "Contact the team with the model, order details and a description of the issue so it can be discussed."
                    }
                  }
                ]
              }
            ]
          }
        },
